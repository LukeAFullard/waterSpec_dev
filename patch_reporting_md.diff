+
+        # For markdown, we often prefer saving the base64 plots to disk next to the md file
+        # and referencing them directly so they render natively in github/gitlab.
+        import base64
+
+        for i, plot in enumerate(context["plots"]):
+            try:
+                ext = plot["mime_type"].split("/")[-1]
+                if ext == "svg+xml":
+                    ext = "svg"
+                plot_filename = f"plot_{i}.{ext}"
+                plot_path = os.path.join(output_dir, plot_filename)
+                with open(plot_path, "wb") as f:
+                    f.write(base64.b64decode(plot["b64_string"]))
+                plot["local_path"] = plot_filename
+            except Exception as e:
+                context["plot_errors"].append(f"Failed to save plot to disk: {str(e)}")
+
